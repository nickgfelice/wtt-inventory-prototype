# Google Service Account credentials (full JSON content of the key file)
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Google Sheets API for the project
# Download the JSON key and paste its entire content here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# Google Sheets spreadsheet ID
# Found in the spreadsheet URL: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit
# Share the spreadsheet with the service account email (Editor access)
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# Enable demo mode (frontend only, no API calls)
# Set to "true" to use in-memory mock data instead of Google Sheets
VITE_DEMO_MODE=false

# Staff authentication
# Generate a random value with at least 32 characters. Keep this secret.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Shared password required to manage inventory. This is checked server-side only.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Local HTTP dev needs insecure cookies. On Vercel this can be omitted.
AUTH_COOKIE_SECURE=false
